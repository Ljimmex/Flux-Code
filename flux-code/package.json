{
  "name": "flux-code",
  "version": "0.1.0",
  "description": "AI Code Assistant Desktop App",
  "main": "dist-electron/main.js",
  "author": "Flux Code",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "electron": "npm run build:electron && electron .",
    "start": "concurrently --kill-others --names \"VITE,ELCTR\" --prefix-colors \"cyan,green\" \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "pack": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "framer-motion": "^12.38.0",
    "openai": "^6.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
